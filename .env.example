# ========================================================
# Farm Management System - Root Environment Configuration Template
# ========================================================

# Application Environment
APP_ENV=development
DEBUG=true

# Backend (FastAPI)
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api

# Database (PostgreSQL)
# Prepared for Phase 2 database connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farm_db

# Security & JWT (To be configured in Authentication Phase)
SECRET_KEY=change-to-a-secure-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_NAME="Farm Management System"
